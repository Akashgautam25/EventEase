// prisma/schema.prisma

// 1️⃣ Datasource
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 2️⃣ Generator
generator client {
  provider = "prisma-client-js"
}

// 3️⃣ Models
model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String?
  provider      String
  role          String         @default("USER")
  registrations Registration[]
}

model Event {
  id            Int            @id @default(autoincrement())
  title         String
  description   String
  category      String
  date          DateTime
  location      String
  price         Float          @default(0)
  totalSeats    Int
  availableSeats Int
  createdBy     Int
  registrations Registration[]
}

model Registration {
  id          Int      @id @default(autoincrement())
  userId      Int
  eventId     Int
  ticketCount Int      @default(1)
  user        User     @relation(fields: [userId], references: [id])
  event       Event    @relation(fields: [eventId], references: [id])
  
  @@unique([userId, eventId])
}
